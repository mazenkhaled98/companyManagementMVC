@model ResetPasswoedViewModel
@{
    ViewData["Title"] = "ResetPassword";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="main-agileinfo">
    <div class="agileits-top">
        <form asp-action="ResetPassword" asp-controller="Account" method="post">
            <div asp-validation-summary="All"></div>

            <input asp-for="NewPassword" placeholder="New Password">
            <span asp-validation-for="NewPassword"></span>
            <br />
            <input asp-for="ConfirmPassword" placeholder="Confirm Password">
            <span asp-validation-for="ConfirmPassword"></span>
            <br />
            <input type="submit" value="Submit">
        </form>
    </div>
</div>



